# Optional agent-entry configuration, not flags automatically read by the CLI.
# Source with: set -a && source /path/to/AK.skill/config/skills-auditor.ak.env && set +a
AK_SKILL_ROOT="${AK_SKILL_ROOT:-$HOME/AK.skill}"
export SKILLS_AUDITOR_EXTRA_ROOTS="$AK_SKILL_ROOT/skills"
# Remote drift inspection fetches Git remotes; opt in when that is intended.
export SKILLS_AUDITOR_WITH_DRIFT="${SKILLS_AUDITOR_WITH_DRIFT:-0}"
